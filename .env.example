APP_NAME=Payment Service
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO
API_KEY=change-me-to-a-long-random-secret
POSTGRES_PASSWORD=postgres
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/
PAYMENT_PROCESSING_MIN_DELAY=2.0
PAYMENT_PROCESSING_MAX_DELAY=5.0
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_ATTEMPTS=3
BROKER_TIMEOUT_SECONDS=5.0
DELIVERY_LEASE_SECONDS=30.0
WORKER_POLL_SECONDS=1.0
RETRY_BASE_SECONDS=1.0
RABBITMQ_PREFIX=payments
CONSUME_LEGACY_QUEUE=true
